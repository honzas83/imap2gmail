SOURCE_IMAP_SERVER=imap.example.com
SOURCE_EMAIL=user@example.com
SOURCE_PASSWORD=password

DEST_IMAP_SERVER=imap.gmail.com
DEST_EMAIL=user@gmail.com
DEST_PASSWORD=gmail-app-password

CHECK_INTERVAL_SECONDS=60
SOURCE_IMAP_TIMEOUT_SECONDS=30
DEST_IMAP_TIMEOUT_SECONDS=300
EXCLUDE_IMPORTANT_SENDERS=noreply@example.com,alerts@monitor.com
LOG_LEVEL=INFO

# Optional: Path to Ollama filtering/classification YAML config file
# OLLAMA_CONFIG_PATH=ollama_config.yaml

# Optional: Path to main configuration YAML file (combines classification & local saver)
# CONFIG_PATH=config.yaml


ollama:
  # The Ollama base endpoint URL
  endpoint: "http://localhost:11434"
  # The model to use for classification. Defaults to gemma4:e4b if not specified.
  model: "gemma4:e4b"
  # Timeout in seconds for Ollama requests. Defaults to 30.
  timeout: 30
  # Optional htdigest credentials (username and password)
  # username: "myuser"
  # password: "mypassword"

classification:
  # Optional cleanup prompt template. If set to true, it will use the default email cleanup prompt.
  # If set to a string, it will use the custom string. If omitted, no cleanup is performed.
  cleanup_prompt: |
    You are an email cleanup assistant.
    Your task is to remove the history of previous messages (such as quoted replies, forwards, or older threads) from the email content below.
    Do not remove the current message's text, signatures, footers, disclaimers, greetings, or sign-offs, as they are important for classification.
    Return ONLY the current message's content. Do not wrap it in markdown block quotes (such as ```) or add conversational prefix/suffix text. Do not apply any markdown formatting (such as bold, italics, or headers) to the output; return it strictly as raw plain text.

    Subject: {subject}
    From: {from_display}
    Email content:
    {body}
  # Maximum number of email body characters sent to Ollama. Defaults to 8192.
  max_body_chars: 8192

  # The prompt template used to query the LLM. 
  # You can use placeholders {subject}, {from_display}, {to_display}, {cc_display}, {recipients}, {body}, {current_date}, and {schema} which will be filled automatically.
  prompt: |
    You are an assistant that classifies incoming emails.
    Analyze the following email and respond with JSON matching this schema:
    {schema}
    
    Current Date: {current_date}
    From: {from_display}
    To: {to_display}
    Cc: {cc_display}
    Subject: {subject}

    Body:
    {body}
  
  # The JSON Schema defining the expected structure of the output.
  # Do not modify the top-level keys ('important', 'spam', 'tags') as the transfer script relies on them.
  schema:
    type: object
    properties:
      important:
        type: boolean
        description: "True if the email contains important, urgent, or high-priority information."
      spam:
        type: boolean
        description: "True if the email is spam, unsolicited advertising, or a phishing attempt."
      tags:
        type: array
        items:
          type: string
        description: "List of descriptive category tags/labels to assign to the email (e.g., Receipts, Work, School)."
    required:
      - important
      - spam
      - tags

local_saver:
  # Enable or disable saving copies of emails locally as EML files
  enabled: false
  # Directory where EML files should be archived
  directory: "./archive"
  # Layout structure:
  # - 'flat': saves as directory/subject.eml
  # - 'structured': saves as directory/YYYY/MM/YYYY-MM-DD-from-subject.eml
  structure: "structured"

